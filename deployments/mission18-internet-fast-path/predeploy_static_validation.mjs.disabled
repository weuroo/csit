// PRE-STAGED ONLY. DO NOT RUN AS A DEPLOY HOOK DURING FEATURE FREEZE.
// Run locally/CI after post-Exit materialization and before any deployment.
import fs from 'node:fs';
import crypto from 'node:crypto';

const CANONICAL='https://example.com/';
const files={executor:process.argv[2]};
if(!files.executor) throw new Error('USAGE: node validator executor');

const read=(p)=>fs.readFileSync(p,'utf8');
const sha256=(s)=>crypto.createHash('sha256').update(s).digest('hex');
const src={executor:read(files.executor)};
const failures=[];
const requireText=(text,label)=>{if(!src.executor.includes(text))failures.push(`executor:MISSING_${label}`)};
const forbidText=(text,label)=>{if(src.executor.includes(text))failures.push(`executor:FORBIDDEN_${label}`)};

requireText(`const TARGET='${CANONICAL}'`,'EXACT_CANONICAL_TARGET');
requireText('GENERAL_PRODUCTION_NETWORK_MUST_REMAIN_DISABLED','GENERAL_NETWORK_FAIL_CLOSED');
requireText('pm_internet_transport_proof_reserve_request_v1','ATOMIC_RESERVATION');
requireText('pm_internet_transport_proof_finalize_request_v1','IDEMPOTENT_FINALIZE');
requireText('CALLER_SELECTED_TARGET_FORBIDDEN','NO_CALLER_TARGET');
requireText('MAX_TOTAL_MS=10_000','TOTAL_TIMEOUT_10S');
requireText('MAX_BYTES=1_048_576','MAX_RESPONSE_1MIB');
requireText('MAX_REDIRECTS=3','MAX_REDIRECTS_3');
requireText("next.protocol!=='https:'||next.hostname.toLowerCase()!==current.hostname.toLowerCase()",'SAME_HOST_HTTPS_REDIRECT_ONLY');
requireText('slotRemainsConsumed:true','FAILED_SLOT_CONSUMED');
requireText('retryRequiresFreshReviewAndOwnerApproval:true','FAILED_RETRY_REQUIRES_FRESH_OWNER');
requireText('can_delegate','DELEGATION_CHECK');
forbidText('paojai-mission-control-hub.vercel.app/api/internet-proof-redirect','OLD_PM_TARGET');
forbidText('EXPECTED_REDIRECT_PATH','MANDATORY_REDIRECT_ASSUMPTION');
forbidText("url=String(body.url",'CALLER_URL_PARSE');
forbidText('production_network_enabled&&','GENERAL_NETWORK_ENABLE_DEPENDENCY');

const result={passed:failures.length===0,canonicalTarget:CANONICAL,files,sha256:{executor:sha256(src.executor)},failures};
console.log(JSON.stringify(result,null,2));
if(failures.length) process.exit(1);

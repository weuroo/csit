// PRE-STAGED ONLY. DO NOT RUN AS A DEPLOY HOOK DURING FEATURE FREEZE.
// Run locally/CI after post-Exit materialization and before any deployment.
import fs from 'node:fs';
import crypto from 'node:crypto';

const CANONICAL='https://example.com/';
const files={executor:process.argv[2],gateway:process.argv[3],approval:process.argv[4]};
if(!files.executor||!files.gateway||!files.approval) throw new Error('USAGE: node validator executor gateway approval');
const read=(p)=>fs.readFileSync(p,'utf8');
const sha256=(s)=>crypto.createHash('sha256').update(s).digest('hex');
const src={executor:read(files.executor),gateway:read(files.gateway),approval:read(files.approval)};
const failures=[];
const requireText=(component,text,label)=>{if(!src[component].includes(text))failures.push(`${component}:MISSING_${label}`)};
const forbidText=(component,text,label)=>{if(src[component].includes(text))failures.push(`${component}:FORBIDDEN_${label}`)};

// Proof executor invariants.
requireText('executor',`const TARGET='${CANONICAL}'`,'EXACT_CANONICAL_TARGET');
requireText('executor','GENERAL_PRODUCTION_NETWORK_MUST_REMAIN_DISABLED','GENERAL_NETWORK_FAIL_CLOSED');
requireText('executor','pm_internet_transport_proof_reserve_request_v1','ATOMIC_RESERVATION');
requireText('executor','pm_internet_transport_proof_finalize_request_v1','IDEMPOTENT_FINALIZE');
requireText('executor','pm_internet_transport_proof_emergency_relock_v1','INDEPENDENT_EMERGENCY_RELOCK');
requireText('executor','CALLER_SELECTED_TARGET_FORBIDDEN','NO_CALLER_TARGET');
requireText('executor','MAX_TOTAL_MS=10_000','TOTAL_TIMEOUT_10S');
requireText('executor','MAX_BYTES=1_048_576','MAX_RESPONSE_1MIB');
requireText('executor','MAX_REDIRECTS=3','MAX_REDIRECTS_3');
requireText('executor',"next.protocol!=='https:'||next.hostname.toLowerCase()!==current.hostname.toLowerCase()",'SAME_HOST_HTTPS_REDIRECT_ONLY');
requireText('executor','slotRemainsConsumed:true','FAILED_SLOT_CONSUMED');
requireText('executor','retryRequiresFreshReviewAndOwnerApproval:true','FAILED_RETRY_REQUIRES_FRESH_OWNER');
requireText('executor','can_delegate','DELEGATION_CHECK');
requireText('executor',"socket.once('connect'",'REAL_TCP_CONNECT_EVIDENCE');
requireText('executor','selected_ip','VALIDATED_PINNED_IP');
requireText('executor','remote_address_matches_selected','REMOTE_ADDRESS_PIN_BINDING');
requireText('executor','redirect_revalidation_required:redirectObserved','REDIRECT_REQUIREMENT_EXPLICIT');
requireText('executor','redirect_revalidation_satisfied:redirectSatisfied','REDIRECT_SATISFACTION_EXPLICIT');
requireText('executor','network_request_performed:networkPerformed','NETWORK_EVIDENCE_EXPLICIT');
requireText('executor','network_execution_allowed!==true','RESERVATION_NETWORK_AUTH_EXPLICIT');
requireText('executor','duplicate===true','RESERVATION_REPLAY_FAIL_CLOSED');
requireText('executor','cleanup_verified','CLEANUP_VERIFICATION_EXPLICIT');
forbidText('executor','paojai-mission-control-hub.vercel.app/api/internet-proof-redirect','OLD_PM_TARGET');
forbidText('executor','EXPECTED_REDIRECT_PATH','MANDATORY_REDIRECT_ASSUMPTION');
forbidText('executor',"url=String(body.url",'CALLER_URL_PARSE');
forbidText('executor','production_network_enabled&&','GENERAL_NETWORK_ENABLE_DEPENDENCY');
forbidText('executor','redirectObserved?true:true','FABRICATED_REDIRECT_CONNECT_EVIDENCE');
forbidText('executor','signature_verified','CALLER_SIGNATURE_AUTHORITY');

// Reservation ambiguity must be resolved before promotion. A committed reservation with a lost RPC
// response cannot be treated as a non-consuming rejection. Promotion remains blocked until the executor
// has an explicit ambiguous-outcome branch that emergency-relocks before any DNS/network attempt.
requireText('executor','RESERVATION_OUTCOME_AMBIGUOUS','AMBIGUOUS_RESERVATION_FAIL_CLOSED_MARKER');

// Crypto-bound Owner Command Gateway invariants.
requireText('gateway','pm_owner_command_gateway_v2','GATEWAY_V2');
requireText('gateway',"p_source_component is distinct from 'pm-owner-internet-pilot-approval-shadow-v5'",'EXACT_APPROVAL_SOURCE');
requireText('gateway',"'WEBAUTHN_ASSERTION_VERIFIED_SERVER_SIDE'",'SERVER_WEBAUTHN_MARKER');
requireText('gateway',"coalesce((s.evidence->>'verified')::boolean,false)=true",'PERSISTED_VERIFIED_STEPUP');
requireText('gateway',"s.used_at is not null",'CONSUMED_STEPUP');
requireText('gateway',"s.credential_id=dev.credential_id",'TRUSTED_CREDENTIAL_BINDING');
requireText('gateway',"s.evidence->>'nonce'=cmd.nonce",'NONCE_BINDING');
requireText('gateway',"s.evidence->>'payload_hash'=cmd.payload_hash",'PAYLOAD_HASH_BINDING');
requireText('gateway',"s.evidence->>'activation_scope'='TRANSPORT_PROOF_SINGLE_REQUEST'",'EXACT_INTENT_BINDING');
requireText('gateway',"s.evidence->>'transport_proof_target_url'='https://example.com/'",'EXACT_TARGET_BINDING');
requireText('gateway',"coalesce((s.evidence->>'transport_proof_max_requests')::int,0)=1",'ONE_REQUEST_BINDING');
requireText('gateway',"coalesce((s.evidence->>'general_production_network_authorized')::boolean,true)=false",'GENERAL_NETWORK_FALSE_BINDING');
requireText('gateway',"cmd.canonical_payload->>'owner_user_id' <> cmd.owner_user_id::text",'PAYLOAD_OWNER_BINDING');
requireText('gateway',"cmd.canonical_payload->>'device_id' <> cmd.device_id::text",'PAYLOAD_DEVICE_BINDING');
requireText('gateway',"cmd.canonical_payload->>'capability_key' <> 'CONTROLLED_INTERNET_CAPABILITY_GATEWAY_V1'",'PAYLOAD_CAPABILITY_BINDING');
requireText('gateway',"cmd.canonical_payload->>'grantee_agent_key' <> 'PAOJAI_OPERATIONS_AI'",'PAYLOAD_GRANTEE_BINDING');
requireText('gateway',"cmd.canonical_payload->'allowed_actions' <> '[\"PUBLIC_READ\"]'::jsonb",'PAYLOAD_EXACT_ACTIONS_BINDING');
requireText('gateway',"requested_grant_minutes')::int,0) <> 10",'PAYLOAD_EXACT_GRANT_DURATION');
requireText('gateway',"can_delegate')::boolean,true) <> false",'PAYLOAD_NON_DELEGABLE');
requireText('gateway',"cmd.resource_scope->>'capability_key' <> 'CONTROLLED_INTERNET_CAPABILITY_GATEWAY_V1'",'RESOURCE_SCOPE_CAPABILITY_BINDING');
requireText('gateway',"cmd.resource_scope->>'grantee_agent_key' <> 'PAOJAI_OPERATIONS_AI'",'RESOURCE_SCOPE_GRANTEE_BINDING');
requireText('gateway',"cmd.resource_scope->>'activation_scope' <> 'TRANSPORT_PROOF_SINGLE_REQUEST'",'RESOURCE_SCOPE_INTENT_BINDING');
requireText('gateway',"cmd.resource_scope->>'transport_proof_target_url' <> 'https://example.com/'",'RESOURCE_SCOPE_TARGET_BINDING');
requireText('gateway',"transport_proof_max_requests')::int,0) <> 1",'RESOURCE_SCOPE_ONE_REQUEST_BINDING');
requireText('gateway',"'ALLOW_CRYPTO_BOUND_V2'",'CRYPTO_BOUND_AUDIT_DECISION');
requireText('gateway',"revoke all on function public.pm_owner_command_gateway_v2(uuid,text) from public, anon, authenticated",'LEAST_PRIVILEGE_REVOKE');
requireText('gateway',"grant execute on function public.pm_owner_command_gateway_v2(uuid,text) to service_role",'SERVICE_ROLE_ONLY');
forbidText('gateway','p_signature_verified','CALLER_SIGNATURE_BOOLEAN');

// Owner approval endpoint invariants: verification only, no authority side effects.
requireText('approval',"verifyAuthenticationResponse",'SERVER_SIDE_WEBAUTHN_VERIFY');
requireText('approval',"pm_owner_command_gateway_v2",'ROUTE_TO_GATEWAY_V2');
requireText('approval',"verification_reason:'CRYPTO_BOUND_GATEWAY_V2'",'VERIFIED_REASON_BINDING');
requireText('approval',"grantCreated:false",'NO_GRANT_SIDE_EFFECT');
requireText('approval',"ownerLockdownReleased:false",'NO_UNLOCK_SIDE_EFFECT');
requireText('approval',"transportProofLaneEnabled:false",'NO_PROOF_LANE_SIDE_EFFECT');
requireText('approval',"productionNetworkEnabled:false",'NO_GENERAL_NETWORK_SIDE_EFFECT');
requireText('approval',"transport_proof_target_url:'https://example.com/'",'APPROVAL_TARGET_BINDING');
requireText('approval',"transport_proof_max_requests:1",'APPROVAL_ONE_REQUEST_BINDING');
requireText('approval',"requested_grant_minutes:10",'TEN_MINUTE_GRANT_INTENT');
requireText('approval',"can_delegate:false",'NON_DELEGABLE_GRANT_INTENT');
forbidText('approval','p_signature_verified','CALLER_SIGNATURE_BOOLEAN');
forbidText('approval',".insert({grantee_agent_key:'PAOJAI_OPERATIONS_AI'",'DIRECT_GRANT_CREATION');
forbidText('approval',"production_network_enabled:true",'GENERAL_NETWORK_ENABLE');
forbidText('approval',"owner_lockdown_active:false",'DIRECT_LOCKDOWN_RELEASE');

const result={passed:failures.length===0,canonicalTarget:CANONICAL,files,sha256:Object.fromEntries(Object.entries(src).map(([k,v])=>[k,sha256(v)])),failures};
console.log(JSON.stringify(result,null,2));
if(failures.length) process.exit(1);

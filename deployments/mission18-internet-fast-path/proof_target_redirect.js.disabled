// PRE-STAGED ONLY. DO NOT DEPLOY DURING FEATURE FREEZE.
// Intended future route: /api/internet-proof-redirect on the canonical Mission Control Hub domain.
// Purpose: deterministic direct runtime redirect-revalidation proof with no client data and no side effects.

export default function handler(req,res){
  if(req.method!=='GET'){
    res.setHeader('Allow','GET');
    return res.status(405).json({ok:false,error:'METHOD_NOT_ALLOWED'});
  }
  res.setHeader('Cache-Control','no-store');
  res.setHeader('X-Content-Type-Options','nosniff');
  res.setHeader('Referrer-Policy','no-referrer');
  res.setHeader('Location','/api/internet-proof-final');
  return res.status(302).end();
}

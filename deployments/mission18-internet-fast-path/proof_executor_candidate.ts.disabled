// PRE-STAGED ONLY. DO NOT DEPLOY DURING FEATURE FREEZE.
// Mission #18 proof-only executor candidate.
// Key invariant: general production_network_enabled MUST remain false.

import "jsr:@supabase/functions-js/edge-runtime.d.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
import https from "node:https";

const sb=createClient(Deno.env.get('SUPABASE_URL')!,Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!);
const TARGET='https://paojai-mission-control-hub.vercel.app/api/internet-proof-redirect';
const EXPECTED_REDIRECT_PATH='/api/internet-proof-final';
const MAX_MS=10_000, MAX_BYTES=1_048_576, MAX_REDIRECTS=3;
const H={'content-type':'application/json','cache-control':'no-store','x-content-type-options':'nosniff','referrer-policy':'no-referrer'};
const reply=(s:number,d:unknown)=>new Response(JSON.stringify(d),{status:s,headers:H});
const family=(ip:string)=>ip.includes(':')?6:4;

async function stablePublicDns(host:string){
  const resolve=async()=>{
    const all:string[]=[];
    try{all.push(...await Deno.resolveDns(host,'A'))}catch{}
    try{all.push(...await Deno.resolveDns(host,'AAAA'))}catch{}
    const ips=[...new Set(all)].sort();
    if(!ips.length) throw new Error('DNS_NO_ANSWERS');
    const {data,error}=await sb.rpc('pm_internet_resolved_ip_guard_shadow_v1',{p_ips:ips});
    if(error||!data?.allowed) throw new Error('DNS_IP_GUARD_BLOCKED');
    return ips;
  };
  const a=await resolve(), b=await resolve();
  if(JSON.stringify(a)!==JSON.stringify(b)) throw new Error('DNS_REBINDING_SET_CHANGED');
  return b;
}

function pinnedGet(url:URL,ip:string){
  return new Promise<{status:number,location?:string,bytes:number}>((resolve,reject)=>{
    let total=0,settled=false;
    const req=https.request({protocol:'https:',hostname:url.hostname,port:443,path:url.pathname+url.search,method:'GET',servername:url.hostname,rejectUnauthorized:true,headers:{host:url.host,accept:'application/json','user-agent':'PM-Agency-Internet-Proof/1.0'},lookup:(_h:any,_o:any,cb:any)=>cb(null,ip,family(ip))},res=>{
      res.on('data',(c:Buffer)=>{total+=c.length;if(total>MAX_BYTES)req.destroy(new Error('RESPONSE_TOO_LARGE'))});
      res.on('end',()=>{if(!settled){settled=true;clearTimeout(timer);const loc=Array.isArray(res.headers.location)?res.headers.location[0]:res.headers.location;resolve({status:res.statusCode||0,location:loc,bytes:total})}});
      res.on('error',e=>{if(!settled){settled=true;clearTimeout(timer);reject(e)}});
    });
    const timer=setTimeout(()=>{if(!settled){settled=true;req.destroy(new Error('TIMEOUT_FULL_REQUEST'));reject(new Error('TIMEOUT_FULL_REQUEST'))}},MAX_MS);
    req.on('error',e=>{if(!settled){settled=true;clearTimeout(timer);reject(e)}});
    req.end();
  });
}

async function assertProofWindow(commandId:string){
  const {data:ctl,error:ce}=await sb.from('pm_owner_internet_gateway_control_shadow_v1').select('mode,owner_lockdown_active,production_network_enabled,evidence').eq('control_key','CONTROLLED_INTERNET_GATEWAY').single();
  if(ce||!ctl) throw new Error('GATEWAY_CONTROL_MISSING');
  if(ctl.owner_lockdown_active) throw new Error('OWNER_LOCKDOWN_ACTIVE');
  if(ctl.production_network_enabled) throw new Error('GENERAL_PRODUCTION_NETWORK_MUST_REMAIN_DISABLED');
  if(ctl.mode!=='TRANSPORT_PROOF_SINGLE_REQUEST') throw new Error('PROOF_MODE_REQUIRED');
  if(String(ctl.evidence?.source_command_id||'')!==commandId) throw new Error('COMMAND_BINDING_MISMATCH');
  const exp=Date.parse(String(ctl.evidence?.unlock_expires_at||''));
  if(!Number.isFinite(exp)||Date.now()>=exp) throw new Error('PROOF_WINDOW_EXPIRED');

  const {data:lane,error:le}=await sb.from('pm_internet_transport_proof_lane_v1').select('enabled,fixed_target_url,max_requests,network_request_count,proof_completed').eq('lane_key','CONTROLLED_INTERNET_TRANSPORT_PROOF').single();
  if(le||!lane||!lane.enabled||lane.fixed_target_url!==TARGET||lane.max_requests!==1||lane.proof_completed) throw new Error('PROOF_LANE_NOT_READY');

  const {data:grant,error:ge}=await sb.from('pm_agent_capability_grants_v1').select('grant_id,source_command_id,expires_at,allowed_resources').eq('grantee_agent_key','PAOJAI_OPERATIONS_AI').eq('status','ACTIVE').contains('allowed_actions',['PUBLIC_READ']).eq('source_command_id',commandId).gt('expires_at',new Date().toISOString()).limit(1).maybeSingle();
  if(ge||!grant) throw new Error('COMMAND_BOUND_GRANT_REQUIRED');
  if(String(grant.allowed_resources?.fixed_target_url||'')!==TARGET) throw new Error('GRANT_TARGET_BINDING_MISMATCH');
  return {ctl,lane,grant};
}

async function finalize(token:string,outcome:string,evidence:Record<string,unknown>){
  const {data,error}=await sb.rpc('pm_internet_transport_proof_finalize_request_v1',{p_request_token:token,p_outcome:outcome,p_evidence:evidence});
  if(error) throw error;
  return data;
}

Deno.serve(async(req:Request)=>{
  if(req.method!=='POST') return reply(405,{ok:false,error:'METHOD_NOT_ALLOWED',networkRequestPerformed:false});
  let body:any={};try{body=await req.json()}catch{return reply(400,{ok:false,error:'INVALID_JSON',networkRequestPerformed:false})}
  const commandId=String(body.commandId||''), requestToken=String(body.requestToken||''), url=String(body.url||'');
  if(!commandId||!requestToken) return reply(400,{ok:false,error:'COMMAND_AND_REQUEST_TOKEN_REQUIRED',networkRequestPerformed:false});
  if(url!==TARGET) return reply(403,{ok:false,error:'FIXED_TARGET_ONLY',networkRequestPerformed:false});

  try{await assertProofWindow(commandId)}catch(e){return reply(423,{ok:false,error:String((e as Error).message||e),networkRequestPerformed:false})}

  const {data:reservation,error:re}=await sb.rpc('pm_internet_transport_proof_reserve_request_v1',{p_request_token:requestToken,p_command_id:commandId});
  if(re||!reservation?.ok) return reply(423,{ok:false,error:'PROOF_REQUEST_RESERVATION_FAILED',networkRequestPerformed:false});

  let dnsVerified=false, redirectRuntimeVerified=false, networkPerformed=false;
  let current=new URL(TARGET), redirects=0;
  try{
    while(true){
      await assertProofWindow(commandId);
      const ips=await stablePublicDns(current.hostname); dnsVerified=true;
      await assertProofWindow(commandId);
      const result=await pinnedGet(current,ips[0]); networkPerformed=true;

      if(result.status>=300&&result.status<400&&result.location){
        if(redirects>=MAX_REDIRECTS) throw new Error('TOO_MANY_REDIRECTS');
        const next=new URL(result.location,current);
        if(next.protocol!=='https:'||next.hostname.toLowerCase()!==current.hostname.toLowerCase()) throw new Error('CROSS_HOST_OR_NON_HTTPS_REDIRECT_BLOCKED');
        if(redirects===0 && next.pathname!==EXPECTED_REDIRECT_PATH) throw new Error('UNEXPECTED_PROOF_REDIRECT_TARGET');
        await assertProofWindow(commandId);
        await stablePublicDns(next.hostname);
        redirectRuntimeVerified=true;
        current=next;redirects++;continue;
      }

      if(redirects<1||!redirectRuntimeVerified) throw new Error('DETERMINISTIC_REDIRECT_EVIDENCE_REQUIRED');
      if(result.status!==200) throw new Error('PROOF_FINAL_STATUS_NOT_200');

      const evidence={dns_connect_time_verified:dnsVerified,redirect_connect_time_verified:redirectRuntimeVerified,network_request_performed:networkPerformed,status:result.status,bytes:result.bytes,redirects,transport:'PINNED_IP_TLS_HOSTNAME_VERIFIED',fixed_target_url:TARGET,general_production_network_authorized:false};
      const fin=await finalize(requestToken,'SUCCESS',evidence);
      return reply(200,{ok:true,status:result.status,bytes:result.bytes,redirects,networkRequestPerformed:true,proofCompleted:!!fin?.proof_completed});
    }
  }catch(e){
    const evidence={dns_connect_time_verified:dnsVerified,redirect_connect_time_verified:redirectRuntimeVerified,network_request_performed:networkPerformed,error:String((e as Error).message||e),fixed_target_url:TARGET,general_production_network_authorized:false};
    try{await finalize(requestToken,'FAILED',evidence)}catch{}
    return reply(502,{ok:false,error:String((e as Error).message||e),networkRequestPerformed:networkPerformed,slotRemainsConsumed:true});
  }
});

/* REVIEW NOTES
- Requires production_network_enabled=false throughout.
- Separate proof-only artifact, verify_jwt=true, post-Stabilization review/deploy only.
- Requires a real deterministic same-host redirect before completion evidence can pass.
- No example.com fallback or caller-selected target.
- Never retry automatically after reservation; failed attempts consume the slot.
*/

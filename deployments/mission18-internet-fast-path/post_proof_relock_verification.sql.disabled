-- PRE-STAGED ONLY. DO NOT EXECUTE DURING FEATURE FREEZE.
-- Mission #18 post-proof fail-closed verification bundle.
-- Run immediately after the single proof attempt and cleanup/relock sequence.
--
-- v1.6 OUTCOME VERIFICATION SCOPE SAFETY:
-- Whole-mission completion MUST be bound to the exact request token + exact Owner
-- command used for this attempt. Never infer success from "latest" history alone.
-- Before execution, the orchestrator MUST set these transaction-local settings
-- from the exact reservation result and VERIFIED Owner command it already holds:
--   select set_config('pm.mission18_expected_request_token','<exact-request-token>',true);
--   select set_config('pm.mission18_expected_command_id','<exact-command-id>',true);
-- Missing/malformed/mismatched scope is FAIL CLOSED and must not be treated as proof.

DO $$
DECLARE
  expected_token uuid;
  expected_command uuid;
  bound_count int;
BEGIN
  BEGIN
    expected_token := nullif(current_setting('pm.mission18_expected_request_token', true),'')::uuid;
    expected_command := nullif(current_setting('pm.mission18_expected_command_id', true),'')::uuid;
  EXCEPTION WHEN OTHERS THEN
    RAISE EXCEPTION 'MISSION18_POST_PROOF_SCOPE_MALFORMED';
  END;

  IF expected_token IS NULL OR expected_command IS NULL THEN
    RAISE EXCEPTION 'MISSION18_POST_PROOF_EXACT_SCOPE_REQUIRED';
  END IF;

  SELECT count(*) INTO bound_count
  FROM public.pm_internet_transport_proof_request_tokens_v1 r
  WHERE r.request_token=expected_token
    AND r.source_command_id=expected_command
    AND r.lane_key='CONTROLLED_INTERNET_TRANSPORT_PROOF';

  IF bound_count <> 1 THEN
    RAISE EXCEPTION 'MISSION18_POST_PROOF_SCOPE_BINDING_NOT_UNIQUE';
  END IF;
END $$;

with expected_scope as (
  select
    current_setting('pm.mission18_expected_request_token')::uuid as request_token,
    current_setting('pm.mission18_expected_command_id')::uuid as command_id
),
bound_request as (
  select r.*
  from public.pm_internet_transport_proof_request_tokens_v1 r
  join expected_scope e
    on e.request_token=r.request_token
   and e.command_id=r.source_command_id
  where r.lane_key='CONTROLLED_INTERNET_TRANSPORT_PROOF'
),
scope_check as (
  select jsonb_build_object(
    'exact_request_token', e.request_token,
    'exact_command_id', e.command_id,
    'bound_row_count', count(br.request_token),
    'exact_scope_bound', count(br.request_token)=1
  ) as evidence
  from expected_scope e
  left join bound_request br on true
  group by e.request_token,e.command_id
)
select jsonb_build_object(
  'verification_scope', (select evidence from scope_check),
  'gateway', (
    select jsonb_build_object(
      'mode', mode,
      'owner_lockdown_active', owner_lockdown_active,
      'production_network_enabled', production_network_enabled,
      'evidence', evidence,
      'updated_at', updated_at
    )
    from public.pm_owner_internet_gateway_control_shadow_v1
    where control_key = 'CONTROLLED_INTERNET_GATEWAY'
    limit 1
  ),
  'active_grants', (
    select count(*)
    from public.pm_agent_capability_grants_v1
    where grantee_agent_key='PAOJAI_OPERATIONS_AI'
      and 'PUBLIC_READ'=any(allowed_actions)
      and status='ACTIVE'
      and (expires_at is null or expires_at > now())
  ),
  'proof_lane', (
    select jsonb_build_object(
      'enabled', enabled,
      'fixed_target_url',fixed_target_url,
      'max_requests', max_requests,
      'network_request_count', network_request_count,
      'proof_completed', proof_completed,
      'dns_pinning_evidence_collected', dns_pinning_evidence_collected,
      'redirect_revalidation_evidence_collected', redirect_revalidation_evidence_collected
    )
    from public.pm_internet_transport_proof_lane_v1
    where lane_key='CONTROLLED_INTERNET_TRANSPORT_PROOF'
    limit 1
  ),
  'exact_consumed_request', (
    select jsonb_build_object(
      'request_token',request_token,
      'source_command_id',source_command_id,
      'reserved_at',reserved_at,
      'finalized_at',finalized_at,
      'outcome',outcome,
      'evidence',evidence
    )
    from bound_request
  ),
  'authority', public.pm_internet_authority_surface_regression_v1(),
  'contracts', public.pm_internet_post_freeze_contract_validation_v1(),
  'concurrency', public.pm_internet_proof_lane_concurrency_readiness_v1(),
  'failure_policy', public.pm_internet_failed_request_slot_policy_shadow_regression_v1(),
  'rollback_shadow', public.pm_run_internet_executor_release_rollback_shadow_v1(),
  'recovery_kill_switch', public.pm_run_controlled_internet_gateway_recovery_shadow_v1(),
  'central_run_id', public.pm_run_central_safety_regression_v2(),
  'action_run_id', public.pm_run_action_safety_regression_v3(),
  'guardian_run_id', public.pm_run_guardian_safety_regression()
) as mission18_post_proof_relock_verification;

-- PASS criteria after the proof attempt:
-- 1. verification_scope.exact_scope_bound=true and the exact request_token + exact command_id
--    equal the reservation result and VERIFIED Owner command of THIS attempt. "Latest" rows are never sufficient.
-- 2. gateway.mode='SHADOW_ONLY', owner_lockdown_active=true, production_network_enabled=false.
-- 3. active_grants=0 after revoke/expiry cleanup.
-- 4. proof lane fixed_target_url='https://example.com/', enabled=false, max_requests=1, network_request_count=1.
-- 5. exact consumed request remains consumed forever; no decrement/reopen even after failed attempt.
-- 6. For successful completion specifically: exact request outcome='SUCCESS', finalized_at non-null,
--    server-derived bound evidence.network_request_performed=true, fixed_target_url exact example.com,
--    DNS/connect-time evidence passed, redirect policy/revalidation passed, bounded response criteria passed,
--    and lane proof_completed=true with both DNS and redirect-policy evidence flags true.
-- 7. Zero redirects are valid only when evidence.redirect_observed=false and redirect_revalidation_required=false;
--    redirect_connect_time_verified must not be fabricated true in that case.
-- 8. Evidence provenance must bind this exact request token to the attested proof-only executor/artifact and
--    one-time finalize capability. Caller-supplied success JSON is never sufficient.
-- 9. authority/contracts/concurrency/failure-policy/recovery/rollback checks pass.
-- 10. Central / Action / Guardian latest runs must have zero failures and no Critical regression.
-- 11. Any cleanup/relock or scope-binding failure is CRITICAL: keep general network disabled, preserve evidence,
--     escalate; do not retry automatically.
-- 12. Any failed proof attempt still consumes the slot and requires fresh review + fresh Owner approval for retry.

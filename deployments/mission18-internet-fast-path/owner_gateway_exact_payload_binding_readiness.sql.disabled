-- PRE-STAGED ONLY. DO NOT APPLY DURING ACTIVE FEATURE FREEZE.
-- Mission #18 exact-payload authority review.
--
-- Crypto-bound WebAuthn + nonce/payload_hash binding is necessary but not sufficient if the
-- gateway does not independently enforce every authority-bearing field. A service-role caller
-- must never be able to reuse an approved payload_hash while changing an unchecked command field.
--
-- Read-only readiness helper. Review/apply only after Stabilization Exit, after gateway v2 exists,
-- and before fresh Owner Passkey is requested.

create or replace function public.pm_owner_gateway_exact_payload_binding_readiness_v1()
returns jsonb
language sql
security definer
set search_path='public','pg_temp'
as $$
with f as (
  select coalesce(pg_get_functiondef(to_regprocedure('public.pm_owner_command_gateway_v2(uuid,text)')),'') as src
), checks as (
  select
    src <> '' as gateway_v2_present,
    position('p_signature_verified' in src)=0 as no_caller_signature_boolean,
    position($q$canonical_payload->>'owner_user_id'=cmd.owner_user_id::text$q$ in src)>0 as owner_bound,
    position($q$canonical_payload->>'device_id'=cmd.device_id::text$q$ in src)>0 as device_bound,
    position($q$canonical_payload->>'capability_key'='CONTROLLED_INTERNET_CAPABILITY_GATEWAY_V1'$q$ in src)>0 as capability_bound,
    position($q$canonical_payload->>'grantee_agent_key'='PAOJAI_OPERATIONS_AI'$q$ in src)>0 as grantee_bound,
    position($q$canonical_payload->'allowed_actions'='["PUBLIC_READ"]'::jsonb$q$ in replace(src,' ',''))>0 as exact_allowed_actions_bound,
    position($q$coalesce((canonical_payload->>'requested_grant_minutes')::int,0)=10$q$ in replace(src,' ',''))>0 as exact_grant_minutes_bound,
    position($q$coalesce((canonical_payload->>'can_delegate')::boolean,true)=false$q$ in replace(src,' ',''))>0 as no_delegation_bound,
    position($q$canonical_payload->>'activation_scope'='TRANSPORT_PROOF_SINGLE_REQUEST'$q$ in src)>0 as activation_scope_bound,
    position($q$canonical_payload->>'transport_proof_target_url'='https://example.com/'$q$ in src)>0 as target_bound,
    position($q$coalesce((canonical_payload->>'transport_proof_max_requests')::int,0)=1$q$ in replace(src,' ',''))>0 as one_request_bound,
    position($q$coalesce((canonical_payload->>'owner_lockdown_release_max_seconds')::int,0)=120$q$ in replace(src,' ',''))>0 as bounded_unlock_bound,
    position($q$coalesce((canonical_payload->>'general_production_network_authorized')::boolean,true)=false$q$ in replace(src,' ',''))>0 as general_network_false_bound,
    position($q$resource_scope->>'capability_key'='CONTROLLED_INTERNET_CAPABILITY_GATEWAY_V1'$q$ in src)>0 as resource_scope_capability_bound,
    position($q$resource_scope->>'grantee_agent_key'='PAOJAI_OPERATIONS_AI'$q$ in src)>0 as resource_scope_grantee_bound,
    position($q$resource_scope->>'activation_scope'='TRANSPORT_PROOF_SINGLE_REQUEST'$q$ in src)>0 as resource_scope_activation_bound,
    position($q$resource_scope->>'transport_proof_target_url'='https://example.com/'$q$ in src)>0 as resource_scope_target_bound,
    position($q$coalesce((resource_scope->>'transport_proof_max_requests')::int,0)=1$q$ in replace(src,' ',''))>0 as resource_scope_one_request_bound
  from f
)
select jsonb_build_object(
  'passed', gateway_v2_present and no_caller_signature_boolean and owner_bound and device_bound and
            capability_bound and grantee_bound and exact_allowed_actions_bound and exact_grant_minutes_bound and
            no_delegation_bound and activation_scope_bound and target_bound and one_request_bound and
            bounded_unlock_bound and general_network_false_bound and resource_scope_capability_bound and
            resource_scope_grantee_bound and resource_scope_activation_bound and resource_scope_target_bound and
            resource_scope_one_request_bound,
  'gateway_v2_present',gateway_v2_present,
  'no_caller_signature_boolean',no_caller_signature_boolean,
  'owner_bound',owner_bound,
  'device_bound',device_bound,
  'capability_bound',capability_bound,
  'grantee_bound',grantee_bound,
  'exact_allowed_actions_bound',exact_allowed_actions_bound,
  'exact_grant_minutes_bound',exact_grant_minutes_bound,
  'no_delegation_bound',no_delegation_bound,
  'activation_scope_bound',activation_scope_bound,
  'target_bound',target_bound,
  'one_request_bound',one_request_bound,
  'bounded_unlock_bound',bounded_unlock_bound,
  'general_network_false_bound',general_network_false_bound,
  'resource_scope_capability_bound',resource_scope_capability_bound,
  'resource_scope_grantee_bound',resource_scope_grantee_bound,
  'resource_scope_activation_bound',resource_scope_activation_bound,
  'resource_scope_target_bound',resource_scope_target_bound,
  'resource_scope_one_request_bound',resource_scope_one_request_bound,
  'authority_expansion',false,
  'production_mutation',false,
  'network_request_performed',false,
  'required_if_failed','Harden pm_owner_command_gateway_v2 so every authority-bearing canonical_payload and resource_scope field is exact-bound before Owner Passkey.'
)
from checks;
$$;

revoke all on function public.pm_owner_gateway_exact_payload_binding_readiness_v1() from public, anon, authenticated;
grant execute on function public.pm_owner_gateway_exact_payload_binding_readiness_v1() to service_role;

-- PASS REQUIRED BEFORE OWNER PASSKEY:
-- - gateway v2 independently derives WebAuthn authority
-- - exact command payload and resource_scope are fully bound
-- - command helper independently re-checks the same exact semantics
-- - no legacy v1 gateway audit is accepted
-- - approval endpoint has no grant/unlock/lane/network side effects

// PRE-STAGED ONLY. DO NOT DEPLOY DURING FEATURE FREEZE.
// Mission #18 proof-only executor contract.
// Target artifact: pm-controlled-internet-executor-proof

export const PROOF_CONTRACT = Object.freeze({
  fixedTargetUrl: "https://paojai-mission-control-hub.vercel.app/api/internet-proof-redirect",
  expectedRedirectPath: "/api/internet-proof-final",
  maxRequests: 1,
  agent: "PAOJAI_OPERATIONS_AI",
  action: "PUBLIC_READ",
  maxRedirects: 3,
  sameHostRedirectOnly: true,
  timeoutMs: 10_000,
  maxResponseBytes: 1_048_576,
  pinnedIpTlsRequired: true,
  liveGrantRequired: true,
  verifiedV3OwnerCommandRequired: true,
  consumedNonceAndAllowedGatewayAuditRequired: true,
  ownerLockdownMustBeOffForProofOnly: true,
  generalProductionNetworkAuthorized: false,
  atomicReservationBeforeDnsOrNetwork: true,
  reservationPolicy: "FAIL_CLOSED_CONSUME_ON_RESERVATION_NO_AUTORELEASE",
  idempotentFinalizeRequired: true,
  auditEveryOutcome: true,
  returnBody: false,
});

/* Required execution order after Stabilization Exit and technical review:
1. Verify PM-owned target is deployed and deterministically returns same-host HTTPS 302 -> final 200.
2. Validate exact request shape + fixed target. No caller-supplied alternate URL.
3. Validate attested proof artifact hash/version.
4. Validate VERIFIED v3 Owner command / nonce / gateway audit bound to exact canonical target.
5. Validate bounded unlock <=120s; production_network_enabled must remain false.
6. Validate exact-command-bound <=10-minute PAOJAI PUBLIC_READ grant.
7. Run authority + contract + canonical-name + cross-binding + activation + concurrency gates.
8. Atomically reserve the one request token BEFORE DNS/network.
9. Resolve A/AAAA, validate all resolved IPs, re-resolve and require stable validated set.
10. Use pinned-IP HTTPS connection preserving original hostname/SNI/TLS verification.
11. On observed redirect: same original host only, <=3; re-run gates + DNS/IP validation before next connect.
12. Require the deterministic redirect evidence before marking proof complete.
13. Enforce full request timeout <=10s and response accumulation <=1MiB.
14. Audit success/failure/timeout/redirect/size/TLS outcomes without protected content.
15. Finalize idempotently. Failed attempt remains consumed.
16. Immediately relock/revoke/expire, then run all post-proof regressions.

Forbidden:
- generic fetch() without pinned connect-time IP
- caller-supplied signature_verified as authority
- automatic retry after consumed attempt
- credentials/downloads/code execution/external side effects/protected-data egress/cross-client context
- enabling general Production network as part of proof
- example.com fallback, target aliases/wildcards, query-controlled redirects, or cross-host redirects
*/

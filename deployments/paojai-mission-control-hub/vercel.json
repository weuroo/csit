{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/internet-live", "destination": "/internet-live-v2/" },
    { "source": "/internet-live/", "destination": "/internet-live-v2/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
